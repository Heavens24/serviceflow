# ==========================================
# ServiceFlow Application
# ==========================================

FLASK_ENV=development
FLASK_DEBUG=true
TESTING=false


# ==========================================
# Application Security
# ==========================================

SECRET_KEY=replace-me-with-a-strong-secret
JWT_SECRET_KEY=replace-me-with-a-strong-jwt-secret
JWT_ACCESS_TOKEN_HOURS=24


# ==========================================
# Database
# ==========================================

DATABASE_URL=replace-me-with-your-database-url


# ==========================================
# Frontend / CORS
# ==========================================

FRONTEND_URL=http://localhost:5173

CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174,https://serviceflow-gilt.vercel.app


# ==========================================
# ServiceFlow Finance
# ==========================================

SERVICEFLOW_COMMISSION_PERCENT=10
FINANCE_CURRENCY=ZAR
MINIMUM_WITHDRAWAL_AMOUNT=50.00


# ==========================================
# Paystack
# ==========================================

# Keep disabled until payment initialization,
# verification, and webhook handling are ready.
PAYSTACK_ENABLED=false

# Use Paystack TEST keys during development.
PAYSTACK_PUBLIC_KEY=pk_test_replace-me
PAYSTACK_SECRET_KEY=sk_test_replace-me

PAYSTACK_BASE_URL=https://api.paystack.co

# Local development callback.
PAYSTACK_CALLBACK_URL=http://localhost:5173/payment/success

# Optional for now.
# We will finalize webhook verification when
# the Paystack webhook route is implemented.
PAYSTACK_WEBHOOK_SECRET=replace-me


# ==========================================
# Production Reference
# ==========================================

# In production, configure these values in the
# backend hosting provider instead of copying
# your local .env file.
#
# FRONTEND_URL=https://serviceflow-gilt.vercel.app
#
# CORS_ORIGINS=https://serviceflow-gilt.vercel.app
#
# PAYSTACK_CALLBACK_URL=https://serviceflow-gilt.vercel.app/payment/success
#
# PAYSTACK_ENABLED=true
#
# PAYSTACK_PUBLIC_KEY=pk_live_replace-me
#
# PAYSTACK_SECRET_KEY=sk_live_replace-me