# ==========================================
# ServiceFlow Application
# ==========================================

APP_ENV=development
FLASK_ENV=development
FLASK_DEBUG=true
TESTING=false

# ==========================================
# Application Security
# ==========================================

# Generate unique values.
# Never use these example values in production.

SECRET_KEY=replace-me-with-a-long-random-secret
JWT_SECRET_KEY=replace-me-with-a-different-long-random-secret

JWT_ACCESS_TOKEN_HOURS=24

# Maximum JSON/request body size.
MAX_CONTENT_LENGTH_MB=10


# ==========================================
# Database
# ==========================================

# Local example:
DATABASE_URL=sqlite:///serviceflow.db

# Production example:
# DATABASE_URL=postgresql://username:password@host/database


# ==========================================
# Frontend / CORS
# ==========================================

FRONTEND_URL=http://localhost:5173

CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174


# ==========================================
# Proxy / HTTPS
# ==========================================

TRUST_PROXY=false

ENABLE_SECURITY_HEADERS=true
ENABLE_HSTS=false
HSTS_MAX_AGE=31536000


# ==========================================
# ServiceFlow Finance
# ==========================================

SERVICEFLOW_COMMISSION_PERCENT=10
FINANCE_CURRENCY=ZAR
MINIMUM_WITHDRAWAL_AMOUNT=50.00


# ==========================================
# Paystack
# ==========================================

PAYSTACK_ENABLED=false

# Development/test keys only.
PAYSTACK_PUBLIC_KEY=pk_test_replace-me
PAYSTACK_SECRET_KEY=sk_test_replace-me

PAYSTACK_BASE_URL=https://api.paystack.co

PAYSTACK_CALLBACK_URL=http://localhost:5173/payment/success

PAYSTACK_WEBHOOK_SECRET=replace-me

# Must normally remain false.
PAYSTACK_ALLOW_TEST_MODE_IN_PRODUCTION=false


# ==========================================
# Production Reference
# ==========================================

# APP_ENV=production
# FLASK_ENV=production
# FLASK_DEBUG=false
#
# SECRET_KEY=<strong-random-secret>
# JWT_SECRET_KEY=<different-strong-random-secret>
#
# DATABASE_URL=<production-postgresql-url>
#
# FRONTEND_URL=https://serviceflow-gilt.vercel.app
# CORS_ORIGINS=https://serviceflow-gilt.vercel.app
#
# TRUST_PROXY=true
# ENABLE_SECURITY_HEADERS=true
# ENABLE_HSTS=true
#
# PAYSTACK_CALLBACK_URL=https://serviceflow-gilt.vercel.app/payment/success
#
# PAYSTACK_ENABLED=true
# PAYSTACK_PUBLIC_KEY=pk_live_replace-me
# PAYSTACK_SECRET_KEY=sk_live_replace-me
#
# PAYSTACK_ALLOW_TEST_MODE_IN_PRODUCTION=false